{
  "name": "gritgauge",
  "version": "2.0.0",
  "description": "AI-powered co-pilot for open-source maintainers — automate issue triage, PR reviews, security scanning, release notes, and project health tracking with full dashboard, CLI, and API.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cli": "ts-node cli/index.ts",
    "docker:build": "docker build -t gritgauge .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local gritgauge",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "@octokit/graphql": "^8.1.0",
    "@prisma/client": "^5.15.0",
    "next": "14.2.0",
    "next-auth": "^4.24.0",
    "openai": "^4.50.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "date-fns": "^3.6.0",
    "zod": "^3.23.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.0",
    "resend": "^3.2.0",
    "redis": "^4.6.0",
    "ioredis": "^5.4.0",
    "cheerio": "^1.0.0",
    "marked": "^13.0.0",
    "dompurify": "^3.1.0",
    "jsdom": "^24.0.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.0",
    "csv-stringify": "^6.4.0",
    "pdfkit": "^0.15.0",
    "archiver": "^7.0.0",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.3.0",
    "boxen": "^7.1.0",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pdfkit": "^0.13.0",
    "@types/dompurify": "^3.0.0",
    "@types/jsdom": "^21.0.0",
    "prisma": "^5.15.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "jest": "^29.7.0",
    "@jest/types": "^29.6.0",
    "ts-jest": "^29.2.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/user-event": "^14.5.0",
    "@playwright/test": "^1.45.0",
    "prettier": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "ts-node": "^10.9.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yml}": ["prettier --write"]
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
