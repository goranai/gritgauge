# GritGauge will automatically pick up .env.local
# For Docker, copy .env.example to .env and fill in values

# ─── Required ───
DATABASE_URL=postgresql://gritgauge:gritgauge@localhost:5432/gritgauge

# ─── Auth (NextAuth.js) ───
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-at-least-32-characters-long-change-me

# GitHub OAuth (for user login)
# Create at: https://github.com/settings/developers
GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret

# GitHub Personal Access Token (for API access)
# Create at: https://github.com/settings/tokens
# Scopes: public_repo, read:org
GITHUB_TOKEN=ghp_your_token_here

# ─── AI ───
# OpenAI API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─── Optional Services ───

# Email (Resend): https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# Redis (for caching): Leave empty to use in-memory cache
REDIS_URL=redis://localhost:6379

# Stripe (for premium features): https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
