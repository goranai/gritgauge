// Prisma Schema for GritGauge
// Database: PostgreSQL (production) / SQLite (development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Authentication ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubId      String?   @unique
  githubLogin   String?
  githubToken   String?   // encrypted
  openaiKey     String?   // encrypted
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  savedRepos    SavedRepo[]
  apiKeys       ApiKey[]
  notifications Notification[]
  webhooks      Webhook[]
  reports       Report[]
  settings      UserSettings?
}

enum Role {
  USER
  MAINTAINER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User Settings ───

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  defaultPage           String  @default("dashboard")
  theme                 Theme   @default(DARK)
  emailNotifications    Boolean @default(true)
  slackWebhookUrl       String?
  discordWebhookUrl     String?
  triageAutoLabel       Boolean @default(false)
  reviewAutoApprove     Boolean @default(false)
  maxDailyApiCalls      Int     @default(500)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ─── API Keys ───

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  name       String
  key        String   @unique
  scopes     String[] // github, openai, full
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Saved Repositories ───

model SavedRepo {
  id              String   @id @default(cuid())
  userId          String
  owner           String
  name            String
  fullName        String
  description     String?
  stars           Int      @default(0)
  forks           Int      @default(0)
  openIssues      Int      @default(0)
  language        String?
  isMonitored     Boolean  @default(true)
  monitorInterval Int      @default(3600) // seconds
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthSnaps    HealthSnapshot[]
  triageLogs     TriageLog[]
  reviewLogs     ReviewLog[]
  securityScans  SecurityScan[]
  reports        Report[]

  @@unique([userId, fullName])
}

// ─── Health Snapshots (Time Series) ───

model HealthSnapshot {
  id                String   @id @default(cuid())
  repoId            String
  healthScore       Int
  busFactor         Int
  responseTimeAvg   Float
  staleIssueRatio   Float
  prMergeTimeAvg    Float
  contributorCount  Int
  commitFrequency   Int
  openIssues        Int
  openPRs           Int
  snapshotDate      DateTime @default(now())
  createdAt         DateTime @default(now())

  repo SavedRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, snapshotDate])
}

// ─── AI Triage Logs ───

model TriageLog {
  id              String   @id @default(cuid())
  repoId          String
  issueNumber     Int
  issueTitle      String
  priority        String
  effort          String
  suggestedLabels String[] // JSON array
  summary         String
  sentiment       String
  isDuplicate     Boolean  @default(false)
  aiModel         String   @default("gpt-4o-mini")
  tokensUsed      Int      @default(0)
  createdAt       DateTime @default(now())

  repo SavedRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
}

// ─── AI Review Logs ───

model ReviewLog {
  id              String   @id @default(cuid())
  repoId          String
  prNumber        Int
  prTitle         String
  riskLevel       String
  recommendation  String
  keyChanges      String[] // JSON array
  potentialIssues String[] // JSON array
  aiModel         String   @default("gpt-4o-mini")
  tokensUsed      Int      @default(0)
  createdAt       DateTime @default(now())

  repo SavedRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
}

// ─── Security Scans ───

model SecurityScan {
  id              String   @id @default(cuid())
  repoId          String
  scanType        String   // "pr", "dependency", "code", "full"
  targetRef       String?  // PR number or commit SHA
  vulnerabilities Json
  riskScore       Int      @default(0)
  summary         String?
  scannedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  repo SavedRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

// ─── Notifications ───

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // "triage_complete", "review_ready", "health_alert", "security_alert"
  title     String
  body      String
  read      Boolean   @default(false)
  actionUrl String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ─── Webhooks ───

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[] // "triage.completed", "review.completed", "health.alert", "security.alert"
  isActive  Boolean  @default(true)
  lastSentAt DateTime?
  failCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Reports ───

model Report {
  id        String   @id @default(cuid())
  userId    String
  repoId    String?
  title     String
  type      String   // "health", "activity", "security", "custom"
  format    String   // "pdf", "csv", "json", "markdown"
  data      Json
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo SavedRepo? @relation(fields: [repoId], references: [id])
}

// ─── Audit Log ───

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  resourceId String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
